# Local development defaults; replace these values in deployed environments.
POSTGRES_USER=delivery_copilot
POSTGRES_PASSWORD=delivery_copilot
POSTGRES_DB=delivery_copilot
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://delivery_copilot:delivery_copilot@postgres:5432/delivery_copilot

AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4.1-mini
AI_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# Accepted live Agent/LLM timeout; override for slower compatible providers.
AI_LLM_TIMEOUT_SECONDS=120.0
